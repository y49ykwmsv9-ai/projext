    {
      "event_id": "GMV-62BCE-001-R069-E002",
      "round_number": 69,
      "date": "9 September 58 BCE",
      "event_category": "Direct",
      "title": "ESTATE STEWARDS BEGIN KEEPING OPEN HOURS FOR THE NEW BOOK COLLECTION",
      "mentioned_entities": [
        "Gaius Maximus Valerius",
        "estate stewards",
        "estate workers",
        "settlement residents"
      ],
      "body": "The stewards establish regular hours during which people living and working on the estates can enter the rooms holding Valerius’s books. Readers are allowed to consult the works without a fee, while the stewards maintain the inventories and record which volumes have been taken for temporary reading. Men who have never had access to a large private collection begin asking for practical histories, agricultural writings, rhetoric, and works on philosophy alongside the literary texts Valerius collected in Rome. The arrangement is deliberately simple, with access governed by care for the books rather than by rank. Word of the new reading rooms begins moving between the settlements.",
