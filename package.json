{
  "name": "worldforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "build": "node scripts/prepare-world-data.mjs && node scripts/prepare-cliopatria.mjs && next build",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "data:prepare": "node scripts/prepare-world-data.mjs",
    "data:prepare:cliopatria": "node scripts/prepare-cliopatria.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "world-atlas": "^2.0.0",
    "us-atlas": "^3.0.1",
    "maplibre-gl": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.0",
    "typescript": "^5.0.0",
    "@types/d3-geo": "^3.0.0"
  }
}