{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMV-001 Player-Facing Round Output",
  "description": "Sample JSON Schema for the established plain-text GMV roleplay presentation contract. It does not replace gmv-round-v2 persistence.",
  "type": "object",
  "required": [
    "round",
    "character",
    "date_range",
    "events",
    "special_event",
    "running_total",
    "round_end_state",
    "end_of_round",
    "end_of_round_checks"
  ],
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "character": {
      "type": "string"
    },
    "date_range": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_number",
          "date",
          "event_type",
          "headline",
          "involved_parties_entities",
          "article",
          "ai_ledger"
        ],
        "properties": {
          "event_number": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "DIRECT",
              "CONNECTED",
              "SURPRISE",
              "SPECIAL"
            ]
          },
          "headline": {
            "type": "string"
          },
          "involved_parties_entities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "article": {
            "type": "string",
            "minLength": 1
          },
          "ai_ledger": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "metric",
                "before",
                "delta",
                "after",
                "unit",
                "reason",
                "source_event_id",
                "provenance"
              ],
              "properties": {
                "metric": {
                  "type": "string"
                },
                "before": {
                  "type": [
                    "number",
                    "integer"
                  ]
                },
                "delta": {
                  "type": "number"
                },
                "after": {
                  "type": [
                    "number",
                    "integer"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "source_event_id": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "special_event": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "selected",
            "magnitude"
          ],
          "properties": {
            "selected": {
              "type": "boolean"
            },
            "opportunity_chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "magnitude": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "change_index": {
              "type": [
                "number",
                "null"
              ]
            },
            "magnitude_11_eligibility": {
              "type": [
                "number",
                "null"
              ]
            },
            "magnitude_11_checks": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "raw_successes": {
              "type": "integer",
              "minimum": 0
            },
            "accepted_candidates": {
              "type": "integer",
              "minimum": 0
            },
            "magnitude_11_events": {
              "type": "integer",
              "minimum": 0
            },
            "event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "headline": {
              "type": [
                "string",
                "null"
              ]
            },
            "involved_parties_entities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "narrative": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "running_total": {
      "type": "object",
      "required": [
        "Population",
        "Currency",
        "Soldiers",
        "Taxation",
        "Economy",
        "Agriculture",
        "Infrastructure",
        "Trade",
        "Readiness",
        "Morale",
        "Supply",
        "Organization",
        "Stability",
        "Legitimacy",
        "Exhaustion",
        "Technology",
        "Intelligence",
        "Relations",
        "Land Area"
      ],
      "properties": {
        "Population": {
          "type": "number"
        },
        "Currency": {
          "type": "number"
        },
        "Soldiers": {
          "type": "number"
        },
        "Taxation": {
          "type": "number"
        },
        "Economy": {
          "type": "number"
        },
        "Agriculture": {
          "type": "number"
        },
        "Infrastructure": {
          "type": "number"
        },
        "Trade": {
          "type": "number"
        },
        "Readiness": {
          "type": "number"
        },
        "Morale": {
          "type": "number"
        },
        "Supply": {
          "type": "number"
        },
        "Organization": {
          "type": "number"
        },
        "Stability": {
          "type": "number"
        },
        "Legitimacy": {
          "type": "number"
        },
        "Exhaustion": {
          "type": "number"
        },
        "Technology": {
          "type": "number"
        },
        "Intelligence": {
          "type": "number"
        },
        "Relations": {
          "type": "number"
        },
        "Land Area": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "round_end_state": {
      "type": "object",
      "required": [
        "population",
        "currency",
        "soldiers",
        "taxation",
        "economy",
        "agriculture",
        "infrastructure",
        "trade",
        "readiness",
        "morale",
        "supply",
        "organization",
        "stability",
        "legitimacy",
        "exhaustion",
        "technology",
        "intelligence",
        "relations",
        "land_area",
        "accounting"
      ],
      "properties": {
        "population": {
          "type": "number"
        },
        "currency": {
          "type": "number"
        },
        "soldiers": {
          "type": "number"
        },
        "taxation": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "economy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "agriculture": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "infrastructure": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "trade": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "morale": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "supply": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "organization": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "legitimacy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "exhaustion": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "technology": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "intelligence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "relations": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "land_area": {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "accounting": {
          "type": "object",
          "required": [
            "public_account",
            "private_account",
            "private_transfer_rate",
            "last_round_net_public_commercial_profit",
            "last_round_private_transfer",
            "gross_receipts",
            "operating_security_maintenance",
            "investment_principal",
            "realized_investment_returns"
          ],
          "properties": {
            "public_account": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "private_account": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "private_transfer_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "last_round_net_public_commercial_profit": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "last_round_private_transfer": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "gross_receipts": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "operating_security_maintenance": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "investment_principal": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            },
            "realized_investment_returns": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ]
            }
          }
        }
      }
    },
    "end_of_round": {
      "type": "string"
    },
    "end_of_round_checks": {
      "type": "object",
      "required": [
        "special_event_resolution",
        "commit_check"
      ],
      "properties": {
        "special_event_resolution": {
          "type": "object",
          "required": [
            "selected",
            "opportunity_chance",
            "magnitude",
            "magnitude_11_checks",
            "magnitude_11_events"
          ],
          "properties": {
            "selected": {
              "type": "boolean"
            },
            "opportunity_chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "magnitude": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 10
            },
            "magnitude_11_eligibility": {
              "type": [
                "number",
                "null"
              ]
            },
            "magnitude_11_checks": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "raw_successes": {
              "type": "integer",
              "minimum": 0
            },
            "accepted_candidates": {
              "type": "integer",
              "minimum": 0
            },
            "magnitude_11_events": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "commit_check": {
          "type": "object",
          "required": [
            "required",
            "verified_after_commit"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "verified_after_commit": {
              "type": "boolean"
            },
            "verification_basis": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
