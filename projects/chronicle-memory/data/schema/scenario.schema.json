{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chronicle Memory Scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "preset_id",
    "clock",
    "player",
    "world",
    "events",
    "causal_graph",
    "provenance"
  ],
  "properties": {
    "scenario_id": { "type": "string" },
    "preset_id": { "type": "string" },
    "clock": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string" },
        "turn": { "type": "integer", "minimum": 0 },
        "last_advance": { "type": ["string", "null"] }
      }
    },
    "player": {
      "type": "object",
      "required": ["role_id"],
      "properties": {
        "role_id": { "type": "string" },
        "polity_id": { "type": ["string", "null"] },
        "character_id": { "type": ["string", "null"] }
      }
    },
    "world": {
      "type": "object",
      "description": "Current alternate-history state. Values may reference canonical observations and derived scenario values."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "date", "type", "summary", "causes", "effects"],
        "properties": {
          "event_id": { "type": "string" },
          "date": { "type": "string" },
          "type": { "type": "string" },
          "summary": { "type": "string" },
          "causes": { "type": "array", "items": { "type": "string" } },
          "effects": { "type": "array", "items": { "type": "string" } },
          "actors": { "type": "array", "items": { "type": "string" } },
          "locations": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "causal_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array" },
        "edges": { "type": "array" }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "claim", "kind"],
        "properties": {
          "source_id": { "type": "string" },
          "claim": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["canonical", "derived", "scenario", "uncertain"]
          }
        }
      }
    }
  }
}
