{
  "schemaVersion": 1,
  "datasetId": "cliopatria-plus-reconquista",
  "title": "Cliopatria+ Reconquista Historical Atlas",
  "purpose": "Project-local extension layer for documentary/game rendering. Cliopatria remains the authoritative polity-geography layer; this atlas adds sourced cities, routes, battles, sieges, political events, people, and scene relationships that are outside Cliopatria's core polity geometry.",
  "temporalScope": {
    "fromYear": 711,
    "toYear": 1492,
    "region": "Iberian Peninsula and directly connected North African/Mediterranean routes"
  },
  "authority": {
    "polityGeometry": "Cliopatria",
    "eventAndPlaceIdentifiers": "Project-local stable IDs linked to Wikidata/Wikipedia or scholarly sources",
    "routeGeometry": "Explicitly modeled documentary reconstruction unless a source supplies a route geometry",
    "uncertaintyRule": "Exact medieval locations and routes are marked approximate when the evidence is disputed or reconstructed"
  },
  "sources": [
    {
      "id": "cliopatria-v0.2.0",
      "type": "dataset",
      "title": "Cliopatria",
      "url": "https://github.com/Seshat-Global-History-Databank/cliopatria",
      "note": "Historical polity polygons and time slices"
    },
    {
      "id": "wikidata",
      "type": "knowledge-base",
      "title": "Wikidata",
      "url": "https://www.wikidata.org/",
      "note": "Stable identifiers and structured place/event metadata"
    },
    {
      "id": "britannica-reconquista",
      "type": "reference",
      "title": "Encyclopaedia Britannica: Reconquista",
      "url": "https://www.britannica.com/event/Reconquista"
    },
    {
      "id": "britannica-al-andalus",
      "type": "reference",
      "title": "Encyclopaedia Britannica: Al-Andalus",
      "url": "https://www.britannica.com/place/Al-Andalus"
    },
    {
      "id": "cambridge-ncmh",
      "type": "scholarship",
      "title": "The New Cambridge Medieval History",
      "url": "https://www.cambridge.org/core/books/new-cambridge-medieval-history/"
    }
  ],
